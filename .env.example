# Supabase — OBAVEZNO Session pooler, port 5432 (Direct connection radi samo preko IPv6,
# Render ga ne dohvata). Kopirati iz Supabase → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.xxxxx:lozinka@aws-0-region.pooler.supabase.com:5432/postgres

NODE_ENV=development
PORT=5000

# Adresa na kojoj aplikacija zaista radi — koristi je alati/provjeri.mjs kad se doda.
APP_URL=http://localhost:5000
